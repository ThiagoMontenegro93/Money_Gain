{
  "name": "lendcontrol-pro",
  "version": "6.5.0",
  "private": true,
  "description": "LendControl Pro V6.5 - controle de empréstimos pessoais com re-empréstimo via funcionários",
  "scripts": {
    "build:core": "pnpm --filter @lendcontrol/core build",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @lendcontrol/api start:dev",
    "dev:web": "pnpm --filter @lendcontrol/app web",
    "db:migrate": "pnpm --filter @lendcontrol/api prisma:migrate",
    "db:seed": "pnpm --filter @lendcontrol/api prisma:seed"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" }
}
